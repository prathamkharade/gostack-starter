# Caddy gets and renews TLS certificates automatically (Let's Encrypt / ZeroSSL).
{
	email {$ACME_EMAIL:admin@example.com}
	servers {
		protocols h1 h2 h3
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	# Small bodies everywhere except uploads: blocks large-body abuse before it reaches the app.
	@notUpload not path /uploads /uploads/
	request_body @notUpload {
		max_size 1MB
	}
	@upload path /uploads /uploads/
	request_body @upload {
		max_size 70MB
	}

	header {
		-Server
		-Via
	}

	reverse_proxy app:8080 {
		health_uri /healthz
		lb_try_duration 5s   # rides out the ~1 s restart during deploys
	}

	# No access log by default: IP addresses are personal data. Enable with a
	# retention plan if you need it (see docs/compliance/data-storage.md).
}
