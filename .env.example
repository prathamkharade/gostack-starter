# Copy to .env (make setup does this and fills in the secrets).
# Every setting is documented in internal/config/config.go.

# --- App ---------------------------------------------------------------------
APP_ENV=development            # development | production
APP_NAME=MyApp
BASE_URL=http://localhost:8080 # public URL, https in production
ADDR=:8080
LOG_LEVEL=info
SITE_DESCRIPTION=A fast, privacy-friendly web application.

# --- Organisation (privacy notice, security.txt) -------------------------------
ORG_NAME=MyApp Ltd
ORG_EMAIL=privacy@example.com
SECURITY_CONTACT=mailto:security@example.com
DEFAULT_LOCALE=en

# --- Database ------------------------------------------------------------------
# dev Postgres from compose.yaml listens on DB_PORT (default 5433)
DATABASE_URL=postgres://app:app@localhost:5433/app?sslmode=disable
DB_MAX_CONNS=10

# --- Secrets (generate with: go run ./cmd/app keygen) ---------------------------
# NEVER commit real values. Losing ENCRYPTION_KEYS = losing encrypted personal data: back them up
# in a password manager / secrets vault, separately from database backups.
JWT_SECRET=
BLIND_INDEX_KEY=
ENCRYPTION_KEYS=
COOKIE_SECURE=false            # true in production (requires https)
# Reverse-proxy IPs/CIDRs to trust for client IP, e.g. 172.16.0.0/12 when behind Caddy in Docker
TRUSTED_PROXIES=
# Login session lifetimes (Go durations)
ACCESS_TTL=15m
REFRESH_TTL=720h

# --- Email (any SMTP provider) ---------------------------------------------------
# Dev: Mailpit catches everything at http://localhost:8025
MAIL_FROM=MyApp <no-reply@example.com>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_TLS=none                  # none (dev) | starttls (587) | tls (465)
# Amazon SES:  SMTP_HOST=email-smtp.eu-central-1.amazonaws.com SMTP_PORT=587 SMTP_TLS=starttls
# Brevo:       SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_TLS=starttls
# Resend:      SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_TLS=tls SMTP_USER=resend SMTP_PASS=<api key>
# Postmark:    SMTP_HOST=smtp.postmarkapp.com SMTP_PORT=587 SMTP_TLS=starttls (user & pass = server token)

# --- SMS (optional; email codes are free, SMS costs per message) -----------------
SMS_PROVIDER=log               # log | twilio | vonage
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VONAGE_API_KEY=
VONAGE_API_SECRET=

# --- File storage -----------------------------------------------------------------
STORAGE_DRIVER=local           # local | s3
STORAGE_LOCAL_DIR=./data/media
# S3-compatible (Cloudflare R2 has free egress):
# e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# optional CDN/custom domain for PUBLIC files only
S3_PUBLIC_URL=
S3_PATH_STYLE=true

# --- Media processing ----------------------------------------------------------------
MEDIA_MAX_UPLOAD_MB=64
MEDIA_IMAGE_FORMAT=webp        # webp (fast, universal) | avif (~20-30% smaller, slower to encode)
MEDIA_IMAGE_QUALITY=75
MEDIA_IMAGE_WIDTHS=320,640,1280,1920
MEDIA_VIDEO_CODEC=h264         # h264 (universal) | av1 (30-50% smaller, slow encode)
MEDIA_VIDEO_MAX_HEIGHT=720
MEDIA_KEEP_ORIGINAL=false      # true doubles storage; keep only if you must

# --- Privacy / retention (days) -------------------------------------------------------
RETENTION_AUDIT_DAYS=365
RETENTION_JOBS_DAYS=7

# --- SEO / GEO -------------------------------------------------------------------------
AI_CRAWLERS=search-only        # allow | search-only (answer engines yes, model training no) | block

# --- Worker -----------------------------------------------------------------------------
WORKER_CONCURRENCY=2
