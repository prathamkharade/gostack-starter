{
  "permissions": {
    "allow": [
      "Read(./.env.example)",
      "Edit(./.env.example)",
      "Bash(make *)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go run ./cmd/app *)",
      "Bash(go tool templ *)",
      "Bash(go mod tidy)",
      "Bash(gofmt *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(curl -s http://localhost:8080/*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(docker compose down *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./.env.prod)",
      "Read(./deploy/.env*)",
      "Read(./**/*_templ.go)",
      "Read(./static/vendor/*.min.js)",
      "Read(./static/css/app.css)",
      "Read(./e2e/node_modules/**)",
      "Read(./bin/**)",
      "Read(./tmp/**)",
      "Read(./data/**)",
      "Read(./backups/**)"
    ]
  }
}
